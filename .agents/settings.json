{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "command(rtk git status)",
      "command(rtk git status *)",
      "command(rtk git log)",
      "command(rtk git log *)",
      "command(rtk git diff)",
      "command(rtk git diff *)",
      "command(rtk dotnet build)",
      "command(rtk dotnet build *)",
      "command(rtk dotnet test)",
      "command(rtk dotnet test *)",
      "command(rtk dotnet restore)",
      "command(rtk dotnet restore *)",
      "command(rtk dotnet format)",
      "command(rtk dotnet format *)"
    ],
    "deny": [
      "command(git branch *)",
      "command(rtk git branch *)",
      "command(git commit *)",
      "command(rtk git commit *)",
      "command(git add *)",
      "command(rtk git add *)",
      "command(git rm *)",
      "command(rtk git rm *)",
      "command(git reset *)",
      "command(rtk git reset *)",
      "command(git push *)",
      "command(rtk git push *)",
      "command(rm *)",
      "command(rtk rm *)"
    ]
  }
}
